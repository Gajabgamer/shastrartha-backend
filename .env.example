# LLM Configuration
LLM_PROVIDER=gemini  # anthropic | openai | gemini
LLM_MODEL=gemini-2.5-flash-latest-exp
GEMINI_API_KEYS=your-key-1,your-key-2  # Comma-separated for rotation
LLM_MAX_TOKENS=700

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend CORS
FRONTEND_URL=https://shastrartha.vercel.app

# Verification
NLI_ENABLED=false  # Set false on free tier (saves 1.5GB RAM)
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_ENTAILMENT_THRESHOLD=0.7
MAX_VERIFY_RETRIES=1

# Dense Retrieval (Optional - ChromaDB not included in this deployment)
DENSE_RETRIEVAL=false
CHROMA_COLLECTION=shastrartha_corpus

# Voice (Optional)
TTS_PROVIDER=fish  # fish | none
FISH_API_KEY=your-fish-api-key
FISH_TTS_MODEL=s2.1-pro-free
TTS_VOICE_CHANAKYA=b1c3b5492bd042999077081209b7eff6
TTS_VOICE_NAPOLEON=4022ee05e7b34cc39250e917dc03c172
TTS_VOICE_SUN_TZU=fe2e4e24a3a544dc95e8e5eb7dba7c82
TTS_VOICE_MARCUS_AURELIUS=52c76ed0d88546b69aaa0f1a88a28ea5

# Sabha
SABHA_PUBLIC_URL=  # Leave empty, auto-detected
SABHA_FINAL_SECONDS=60

# Misc
DEMO_MODE=false
TOKEN_DELAY_MS=35
ROUNDS_RANKED=3
ROUNDS_DEMO=2
